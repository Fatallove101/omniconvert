.page { padding: 24rpx 0 60rpx; }

.hero { text-align: center; padding: 40rpx 0 10rpx; }
.hero-badge {
  display: inline-block;
  font-size: 24rpx;
  color: #4f46e5;
  background: #eef2ff;
  border: 1rpx solid #e0e7ff;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
}
.hero-title {
  margin-top: 20rpx;
  font-size: 60rpx;
  font-weight: 800;
  color: #4f46e5;
  letter-spacing: 4rpx;
}

.tool-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(16, 24, 40, 0.06);
}
.tool-icon { font-size: 52rpx; margin-right: 24rpx; }
.tool-text { flex: 1; min-width: 0; }
.tool-name { font-weight: 700; font-size: 32rpx; }
.tool-desc { margin-top: 6rpx; line-height: 1.5; }
.tool-arrow { color: #c0c4cc; font-size: 48rpx; margin-left: 16rpx; }
